# Copy to .env — never commit .env.
# Generate a master key:  openssl rand -hex 32
LITELLM_MASTER_KEY=sk-ai-bridge-CHANGEME

# Provide only the key(s) your chosen backend needs.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
UPSTREAM_API_KEY=

# Ollama / vLLM need no key, just api_base in config.yaml.

# Troubleshooting only — logs full prompts and responses.
# LITELLM_LOG=DEBUG
