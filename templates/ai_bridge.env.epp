<%- | String $master_key,
      Optional[String] $key_env,
      Optional[String] $upstream_key,
      Boolean $debug,
| -%>
# Managed by Puppet (ai_bridge). Secrets live here and only here.
LITELLM_MASTER_KEY=<%= $master_key %>
<% if $key_env and $upstream_key { -%>
<%= $key_env %>=<%= $upstream_key %>
<% } -%>
<% if $debug { -%>
LITELLM_LOG=DEBUG
<% } -%>
# Keep LiteLLM from phoning home or expecting a DB/UI.
LITELLM_TELEMETRY=False
NO_DOCS=True
